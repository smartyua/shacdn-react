{
  "name": "shacdn",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "mcp/shacdn-server",
    "packages/tokens"
  ],
  "exports": {
    "./styles/variables.scss": "./src/styles/variables.scss",
    "./styles/globals.scss": "./src/styles/globals.scss",
    "./styles/theme": "./src/styles/theme.ts",
    "./styles/theme-init": "./src/styles/theme-init.ts",
    "./cn": "./src/lib/cn.ts"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:mcp": "npm run build -w @shacdn/mcp-server",
    "verify": "npm run lint && npm test && npm run build && npm run build:mcp",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:ui": "vitest run --project ui",
    "test:ai": "vitest run --project ai",
    "test:watch": "vitest",
    "shacdn:install": "tsx mcp/shacdn-server/src/cli.ts install",
    "ladle": "ladle serve",
    "ladle:build": "ladle build",
    "prepare": "husky",
    "typecheck": "tsc -b",
    "typecheck:tests": "tsc --noEmit -p tsconfig.test.json",
    "typecheck:ai": "node -e \"if (require('fs').existsSync('.ai/tsconfig.json')) { require('child_process').execSync('tsc -p .ai/tsconfig.json', { stdio: 'inherit' }); } else { console.log('AI infra not bootstrapped, skipping typecheck:ai'); }\"",
    "ai:bootstrap": "tsx .ai/scripts/bootstrap.ts",
    "ai:start": "tsx .ai/scripts/start-services.ts",
    "ai:stop": "tsx .ai/scripts/stop-services.ts",
    "ai:health": "tsx .ai/scripts/health-check.ts",
    "ai:index": "tsx .ai/scripts/index-project.ts --incremental",
    "ai:index:full": "tsx .ai/scripts/index-project.ts --full",
    "ai:index:incremental": "tsx .ai/scripts/index-project.ts --incremental",
    "ai:knowledge:update": "tsx .ai/scripts/update-knowledge.ts",
    "ai:memory:cleanup": "tsx .ai/scripts/cleanup-memory.ts",
    "ai:verify": "tsx .ai/scripts/verify-setup.ts",
    "ai:rag": "tsx .ai/scripts/rag-query.ts",
    "ai:compress": "tsx .ai/scripts/compress-context.ts"
  },
  "lint-staged": {
    "*.{ts,tsx}": "eslint --max-warnings=0"
  },
  "dependencies": {
    "lucide-react": "^1.41.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@ladle/react": "^5.1.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.10.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "lint-staged": "^17.5.0",
    "sass": "^1.104.0",
    "tsx": "^4.23.13",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2",
    "vitest": "^5.0.0",
    "vitest-axe": "^0.1.0",
    "zod": "^4.5.4"
  }
}
